import { useState, useEffect, useCallback } from "react";

const SUPABASE_URL = import.meta.env.VITE_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.VITE_SUPABASE_ANON_KEY;

const headers = {
  apikey: SUPABASE_KEY,
  Authorization: `Bearer ${SUPABASE_KEY}`,
  "Content-Type": "application/json",
};

const YEARS = [2026,2025,2024,2023,2022,2021,2020,2019,2018,2017];

// Market keyword groups — each entry searches event_name for any of its terms
const MARKETS = [
  { label: "Minnesota (MN)",      terms: ["MN", "Minnesota"] },
  { label: "Illinois (IL/Chicago)", terms: ["IL", "Chicago", "Chicagoland"] },
  { label: "Texas — Houston",     terms: ["Houston"] },
  { label: "Texas — DFW",         terms: ["DFW", "Dallas", "Fort Worth", "Collin County", "North Texas"] },
  { label: "Texas — Austin",      terms: ["Austin"] },
  { label: "Texas — San Antonio", terms: ["San Antonio"] },
  { label: "Kansas City",         terms: ["Kansas City"] },
  { label: "Detroit",             terms: ["Detroit"] },
  { label: "Columbus",            terms: ["Columbus"] },
  { label: "Cleveland",           terms: ["Cleveland"] },
  { label: "Indianapolis",        terms: ["Indianapolis"] },
  { label: "Cincinnati",          terms: ["Cincinnati"] },
  { label: "Omaha",               terms: ["Omaha"] },
  { label: "Milwaukee/Madison",   terms: ["Milwaukee", "Madison"] },
  { label: "Nashville",           terms: ["Nashville"] },
  { label: "St. Louis",           terms: ["St. Louis"] },
  { label: "National/Other",      terms: ["National", "Net Lease", "Fargo", "Rochester", "St. Cloud", "Owatonna", "Bozeman", "Louisville", "Miami"] },
];

// Event names containing these words are test/cancelled events — always hidden
const TEST_WORDS = ["test", "do not use", "delete", "cancelled", "canceled", "ignore", "alan test"];

// ── CSV export ────────────────────────────────────────────────
function exportCSV(rows, filename) {
  if (!rows.length) return;
  const cols = Object.keys(rows[0]);
  const csv = [
    cols.join(","),
    ...rows.map((r) =>
      cols.map((c) => `"${String(r[c] ?? "").replace(/"/g, '""')}"`).join(",")
    ),
  ].join("\n");
  const blob = new Blob([csv], { type: "text/csv" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  a.click();
}

// ── Build year filter string for Supabase ─────────────────────
// If multiple years selected, use or=(event_date.gte.2024-01-01,event_date.lte.2024-12-31,...)
// Supabase OR filter for multiple year ranges
function applyYearFilter(url, dateCol, selectedYears) {
  if (selectedYears.size === 0) return;
  if (selectedYears.size === 1) {
    const y = [...selectedYears][0];
    url.searchParams.set(dateCol, `gte.${y}-01-01`);
    // use and param for lte
    url.searchParams.set(`${dateCol}`, `gte.${y}-01-01`);
    // Supabase supports range via two separate params with same key — use append trick
    // Actually set gte and rely on lte via a second param key workaround not supported cleanly
    // Better: just use gte + lte via the and query param
    url.searchParams.delete(dateCol);
    url.searchParams.set("and", `(${dateCol}.gte.${y}-01-01,${dateCol}.lte.${y}-12-31)`);
  } else {
    const sorted = [...selectedYears].sort();
    const parts = sorted.map(y => `and(${dateCol}.gte.${y}-01-01,${dateCol}.lte.${y}-12-31)`);
    url.searchParams.set("or", `(${parts.join(",")})`);
  }
}

