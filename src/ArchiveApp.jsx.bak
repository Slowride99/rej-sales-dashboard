// ── Tab configs ───────────────────────────────────────────────
const TABS = [
  {
    id: "attendees", label: "Attendees", table: "attendees",
    cols: ["first_name","last_name","email","organization","title","lic","address_state","event_name","event_date"],
    filters: ["search","event_name","market","address_state","year"],
  },
  {
    id: "sponsors", label: "Sponsors", table: "sponsors",
    cols: ["logo","name","tiers","website","event_name","event_date"],
    filters: ["search","event_name","market","year"],
  },
  {
    id: "speakers", label: "Speakers", table: "speakers",
    cols: ["picture","first_name","last_name","email","organization","title","event_name","event_date"],
    filters: ["search","event_name","market","year"],
  },
  {
    id: "events", label: "Events", table: "events",
    cols: ["event_name","date","end_date","location","total_registration_count"],
    filters: ["search","market","year"],
  },
  {
    id: "sessions", label: "Sessions", table: "sessions",
    cols: ["title","sub_title","session_date","start_time","end_time","event_name"],
    filters: ["search","event_name","market","year"],
  },
];

const PAGE_SIZE = 100;
function colLabel(col) {
  return col.replace(/_/g," ").replace(/\b\w/g, c => c.toUpperCase());
}

function dateColFor(tabId) {
  if (tabId === "events") return "date";
  if (tabId === "sessions") return "session_date";
  return "event_date";
}

function applyFiltersToUrl(url, { tabId, search, eventName, stateFilter, selectedYears, market }) {
  const dateCol = dateColFor(tabId);

  // Always exclude test/cancelled events
  const testFilter = TEST_WORDS.map(w => `event_name.not.ilike.*${w}*`).join(",");
  // We apply this via and= later merged with year filter if needed

  // Event name keyword
  if (eventName.trim()) {
    url.searchParams.set("event_name", `ilike.*${eventName.trim()}*`);
  }

  // Market filter — OR across all terms for that market
  if (market) {
    const mkt = MARKETS.find(m => m.label === market);
    if (mkt) {
      const orParts = mkt.terms.map(t => `event_name.ilike.*${t}*`).join(",");
      // Will be merged into or= below if no name search, else appended
      url.searchParams.set("or", `(${orParts})`);
    }
  }

  // State (separate column filter)
  if (stateFilter.trim() && tabId === "attendees") {
    url.searchParams.set("address_state", `ilike.*${stateFilter.trim()}*`);
  }

  // Year(s) — use and= for single, or= for multiple
  // Important: or= and name search or= cannot coexist as separate params.
  // Solution: when we have BOTH a name search (or=) AND multiple years (or=),
  // wrap years in and= with nested or, and keep name search as a separate or=.
  const hasYears = selectedYears.size > 0;
  const sorted = hasYears ? [...selectedYears].sort() : [];

  // Name/person search
  if (search.trim()) {
    const s = search.trim();
    if (tabId === "attendees" || tabId === "speakers") {
      // Use or= for name search
      url.searchParams.set("or", `(first_name.ilike.*${s}*,last_name.ilike.*${s}*,email.ilike.*${s}*,organization.ilike.*${s}*)`);
      // Year filter goes into and= so it doesn't conflict
      if (hasYears) {
        if (sorted.length === 1) {
          const y = sorted[0];
          url.searchParams.set("and", `(${dateCol}.gte.${y}-01-01,${dateCol}.lte.${y}-12-31)`);
        } else {
          const parts = sorted.map(y => `and(${dateCol}.gte.${y}-01-01,${dateCol}.lte.${y}-12-31)`);
          url.searchParams.set("and", `(or(${parts.join(",")}))`);
        }
      }
    } else if (tabId === "sponsors") {
      url.searchParams.set("name", `ilike.*${s}*`);
      if (hasYears) {
        const parts = sorted.map(y => `and(${dateCol}.gte.${y}-01-01,${dateCol}.lte.${y}-12-31)`);
        url.searchParams.set(sorted.length === 1 ? "and" : "or", sorted.length === 1
          ? `(${dateCol}.gte.${sorted[0]}-01-01,${dateCol}.lte.${sorted[0]}-12-31)`
          : `(${parts.join(",")})`
        );
      }
    } else {
      url.searchParams.set("event_name", `ilike.*${s}*`);
      if (hasYears) {
        const parts = sorted.map(y => `and(${dateCol}.gte.${y}-01-01,${dateCol}.lte.${y}-12-31)`);
        sorted.length === 1
          ? url.searchParams.set("and", `(${dateCol}.gte.${sorted[0]}-01-01,${dateCol}.lte.${sorted[0]}-12-31)`)
          : url.searchParams.set("or", `(${parts.join(",")})`);
      }
    }
  } else if (hasYears) {
    // No name search — year filter can use or= freely
    if (sorted.length === 1) {
      const y = sorted[0];
      url.searchParams.set("and", `(${dateCol}.gte.${y}-01-01,${dateCol}.lte.${y}-12-31)`);
    } else {
      const parts = sorted.map(y => `and(${dateCol}.gte.${y}-01-01,${dateCol}.lte.${y}-12-31)`);
      url.searchParams.set("or", `(${parts.join(",")})`);
    }
  }
}

// ── Main App ──────────────────────────────────────────────────
export default function App() {
  const [activeTab, setActiveTab]     = useState("attendees");
  const [rows, setRows]               = useState([]);
  const [total, setTotal]             = useState(0);
  const [loading, setLoading]         = useState(false);
  const [page, setPage]               = useState(0);
  const [search, setSearch]           = useState("");
  const [eventName, setEventName]     = useState("");
  const [stateFilter, setStateFilter] = useState("");
  const [selectedYears, setSelectedYears] = useState(new Set());
  const [market, setMarket] = useState("");

  const tab = TABS.find(t => t.id === activeTab);

  const toggleYear = (y) => {
    setSelectedYears(prev => {
      const next = new Set(prev);
      next.has(y) ? next.delete(y) : next.add(y);
      return next;
    });
  };

  const fetchData = useCallback(async () => {
    setLoading(true);
    try {
      const url = new URL(`${SUPABASE_URL}/rest/v1/${tab.table}`);
      url.searchParams.set("select", "*");
      url.searchParams.set("limit", String(PAGE_SIZE));
      url.searchParams.set("offset", String(page * PAGE_SIZE));
      url.searchParams.set("order", `${dateColFor(tab.id)}.desc`);
      applyFiltersToUrl(url, { tabId: tab.id, search, eventName, stateFilter, selectedYears, market });

      const res = await fetch(url.toString(), {
        headers: { ...headers, Prefer: "count=exact" },
      });
      const count = parseInt(res.headers.get("content-range")?.split("/")[1] || "0");
      const data  = await res.json();
      const cleaned = Array.isArray(data) ? data.filter(row => {
        const name = (row.event_name || row.name || "").toLowerCase();
        return !TEST_WORDS.some(w => name.includes(w));
      }) : [];
      setRows(cleaned);
      setTotal(count);
    } catch(e) {
      console.error(e);
      setRows([]);
    }
    setLoading(false);
  }, [activeTab, search, eventName, stateFilter, selectedYears, market, page, tab]);

  useEffect(() => { fetchData(); }, [fetchData]);
  useEffect(() => { setPage(0); }, [search, eventName, stateFilter, selectedYears, market, activeTab]);

  const switchTab = (id) => {
    setActiveTab(id); setSearch(""); setEventName("");
    setStateFilter(""); setSelectedYears(new Set()); setMarket(""); setPage(0);
  };

  const clearFilters = () => {
    setSearch(""); setEventName(""); setStateFilter(""); setSelectedYears(new Set()); setMarket("");
  };

  const fetchExportData = async () => {
    const url = new URL(`${SUPABASE_URL}/rest/v1/${tab.table}`);
    url.searchParams.set("select", "*");
    url.searchParams.set("limit", "10000");
    url.searchParams.set("order", `${dateColFor(tab.id)}.desc`);
    applyFiltersToUrl(url, { tabId: tab.id, search, eventName, stateFilter, selectedYears, market });
    const res = await fetch(url.toString(), { headers });
    return await res.json();
  };

  const handleExport = async () => {
    const data = await fetchExportData();
    exportCSV(data, `${tab.id}_export_${new Date().toISOString().slice(0,10)}.csv`);
  };

  const handleExportDedup = async () => {
    const data = await fetchExportData();
    const seen = new Map();
    for (const row of data) {
      const key = (row.email || "").toLowerCase().trim();
      if (!key) { continue; }
      if (!seen.has(key)) seen.set(key, row);
    }
    const noEmail = data.filter(r => !(r.email || "").trim());
    const deduped = [...seen.values(), ...noEmail];
    exportCSV(deduped, `${tab.id}_unique_${new Date().toISOString().slice(0,10)}.csv`);
  };

  const totalPages = Math.ceil(total / PAGE_SIZE);
  const hasFilters = search || eventName || stateFilter || selectedYears.size > 0 || market;

  return (
    <>
      <style>{css}</style>

      <header className="header">
        <div className="header-left">
          <div className="logo-mark">R</div>
          <div>
            <div className="header-title">PheedLoop Archive</div>
            <div className="header-sub">REJournals Event History</div>
          </div>
        </div>
        <div style={{ fontSize: 12, color: "var(--muted)" }}>Historical data · Read only</div>
      </header>

      <nav className="tabs">
        {TABS.map(t => (
          <button key={t.id} className={`tab ${activeTab === t.id ? "active" : ""}`} onClick={() => switchTab(t.id)}>
            {t.label}
          </button>
        ))}
      </nav>

      <main className="main">
        <div className="filters">

          {tab.filters.includes("search") && (
            <div className="filter-group">
              <span className="filter-label">Search</span>
              <input
                type="text"
                placeholder={
                  tab.id === "attendees" || tab.id === "speakers" ? "Name, email, or company..."
                  : tab.id === "sponsors" ? "Sponsor name..."
                  : "Event name..."
                }
                value={search}
                onChange={e => setSearch(e.target.value)}
                style={{ minWidth: 240 }}
              />
            </div>
          )}

          {tab.filters.includes("event_name") && (
            <div className="filter-group">
              <span className="filter-label">Event Name</span>
              <input
                type="text"
                placeholder='e.g. "MN Office" or "Chicago"'
                value={eventName}
                onChange={e => setEventName(e.target.value)}
                style={{ minWidth: 200 }}
              />
            </div>
          )}

          {tab.filters.includes("market") && (
            <div className="filter-group">
              <span className="filter-label">Market</span>
              <select value={market} onChange={e => setMarket(e.target.value)} style={{ minWidth: 200 }}>
                <option value="">All markets</option>
                {MARKETS.map(m => (
                  <option key={m.label} value={m.label}>{m.label}</option>
                ))}
              </select>
            </div>
          )}

          {tab.filters.includes("address_state") && (
            <div className="filter-group">
              <span className="filter-label">State</span>
              <input
                type="text"
                placeholder="MN, IL, TX..."
                value={stateFilter}
                onChange={e => setStateFilter(e.target.value)}
                style={{ minWidth: 100 }}
              />
            </div>
          )}

          {tab.filters.includes("year") && (
            <div className="filter-group">
              <span className="filter-label">
                Years {selectedYears.size > 0 && <span style={{color:"var(--accent)"}}>({selectedYears.size} selected)</span>}
              </span>
              <div className="year-checks">
                {YEARS.map(y => (
                  <label key={y} className={`year-check ${selectedYears.has(y) ? "checked" : ""}`}>
                    <input type="checkbox" checked={selectedYears.has(y)} onChange={() => toggleYear(y)} />
                    {y}
                  </label>
                ))}
              </div>
            </div>
          )}

          <div className="filter-group" style={{ justifyContent: "flex-end", marginTop: "auto" }}>
            <span className="filter-label">&nbsp;</span>
            <div style={{ display: "flex", gap: 8, paddingTop: 2 }}>
              {hasFilters && (
                <button className="btn btn-ghost btn-sm" onClick={clearFilters}>Clear</button>
              )}
              <button className="btn btn-primary btn-sm" onClick={handleExport}>Export CSV</button>
              {tab.id === "attendees" && (
                <button className="btn btn-ghost btn-sm" onClick={handleExportDedup} style={{borderColor:"var(--accent)",color:"var(--accent)"}}>
                  Export Unique
                </button>
              )}
            </div>
          </div>
        </div>

        <div className="stats-bar">
          <div className="stats-count">
            Showing <span>{rows.length.toLocaleString()}</span> of <span>{total.toLocaleString()}</span> {tab.label.toLowerCase()}
            {selectedYears.size > 0 && (
              <span style={{marginLeft: 8, color: "var(--muted)"}}>
                · {[...selectedYears].sort().join(", ")}
              </span>
            )}
          </div>
          {totalPages > 1 && <div className="page-info">Page {page + 1} of {totalPages}</div>}
        </div>

        <div className="table-wrap">
          {loading ? (
            <div className="state-box"><div className="icon">⟳</div><p>Loading...</p></div>
          ) : rows.length === 0 ? (
            <div className="state-box"><div className="icon">∅</div><p>No results found. Try adjusting your filters.</p></div>
          ) : (
            <table>
              <thead>
                <tr>{tab.cols.map(col => <th key={col}>{colLabel(col)}</th>)}</tr>
              </thead>
              <tbody>
                {rows.map((row, i) => (
                  <tr key={i}>
                    {tab.cols.map(col => (
                      <td key={col} title={col !== "logo" && col !== "picture" ? String(row[col] ?? "") : ""}>
                        {col === "tiers" && row[col] ? (
                          <span className="pill">{row[col]}</span>
                        ) : col === "logo" && row[col] ? (
                          <div className="thumb-cell">
                            <img
                              src={row[col]}
                              alt=""
                              className="thumb-logo"
                              onError={e => { e.target.style.display="none"; }}
                            />
                            <a
                              href={row[col]}
                              target="_blank"
                              rel="noreferrer"
                              className="dl-link"
                              download
                            >↓ logo</a>
                          </div>
                        ) : col === "picture" && row[col] ? (
                          <div className="thumb-cell">
                            <img
                              src={row[col]}
                              alt=""
                              className="thumb"
                              onError={e => { e.target.style.display="none"; }}
                            />
                            <a
                              href={row[col]}
                              target="_blank"
                              rel="noreferrer"
                              className="dl-link"
                              download
                            >↓ photo</a>
                          </div>
                        ) : col === "website" && row[col] ? (
                          <a href={row[col]} target="_blank" rel="noreferrer" className="dl-link" style={{opacity:1}}>
                            {row[col].replace(/^https?:\/\//, "").slice(0, 30)}
                          </a>
                        ) : (
                          row[col] ?? "—"
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>

        {totalPages > 1 && (
          <div className="pagination">
            <button className="btn btn-ghost btn-sm" onClick={() => setPage(p => Math.max(0, p-1))} disabled={page === 0}>← Prev</button>
            <span className="page-info">{page + 1} / {totalPages}</span>
            <button className="btn btn-ghost btn-sm" onClick={() => setPage(p => Math.min(totalPages-1, p+1))} disabled={page >= totalPages-1}>Next →</button>
          </div>
        )}
      </main>
    </>
  );
}